{
  "name": "myexpense",
  "version": "1.0.0",
  "private": true,
  "description": "Phone-friendly per diem and itemized travel expense reports that download as the official Excel forms, print-ready PDFs and receipt bundles. Runs on Claude or as a website (server.js).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "layouts": "python3 tools/extract_layout.py",
    "test": "node test/unit.js && node test/integrity.js && node test/generate.js && python3 test/verify.py",
    "test:e2e": "node test/e2e.js",
    "test:server": "node test/server.js",
    "test:e2e-web": "node test/e2e-web.js",
    "audit": "npm audit --audit-level=low"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "5.2.1",
    "mysql2": "3.24.6",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "htm": "3.1.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0"
  }
}
